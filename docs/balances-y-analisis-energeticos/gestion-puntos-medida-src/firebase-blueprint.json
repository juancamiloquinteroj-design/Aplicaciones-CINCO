{
  "entities": {
    "PM": {
      "title": "PM",
      "description": "Punto de Medida and its history of active failures and interventions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "codigoPM": { "type": "string" },
        "nombrePM": { "type": "string" },
        "estadoGral": { "type": "string", "enum": ["Ok", "En falla", "Instalación", "Para Revisión"] },
        "estructuras": { "type": "array" },
        "activeFailures": { "type": "array" },
        "intervenciones": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "codigoPM", "nombrePM", "estadoGral", "estructuras", "activeFailures", "intervenciones", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/pms/{pmId}": {
      "schema": "PM",
      "description": "Collection of Puntos de Medida"
    }
  }
}
